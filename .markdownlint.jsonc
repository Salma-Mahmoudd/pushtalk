// Markdown lint rules (markdownlint / markdownlint-cli2 and the VS Code extension)
{
  "default": true,
  // Prose and tables are not wrapped at a fixed width
  "MD013": false,
  // Tables use the compact style: "| a | b |" and "| --- | --- |"
  "MD060": { "style": "compact" },
  // HTML only for the centered logo with light/dark variants in README.md
  "MD033": { "allowed_elements": ["p", "picture", "source", "img", "strong", "br"] },
  // README.md starts with the logo instead of a heading
  "MD041": false
}
