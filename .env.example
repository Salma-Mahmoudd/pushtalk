# Copy to .env to override. Every key has a safe development default,
# so the app also starts without a .env file.

# API connections. Defaults reach the docker-compose.dev.yml ports from the host;
# inside Docker the hosts are the service names (postgres:5432, redis:6379).
DATABASE_URL=postgresql+asyncpg://pushtalk:pushtalk@localhost:5433/pushtalk
REDIS_URL=redis://localhost:6380/0

# API logging: DEBUG | INFO | WARNING | ERROR, and json | console output.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Origins allowed to send state-changing requests and open WebSockets (CSRF protection).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# PostgreSQL (docker compose service "postgres").
POSTGRES_USER=pushtalk
POSTGRES_PASSWORD=pushtalk
POSTGRES_DB=pushtalk

# Port of the app (nginx) on the host: http://localhost:8080
WEB_PORT=8080

# Host ports for docker-compose.dev.yml (localhost only). Non-default ports avoid
# clashing with a PostgreSQL, Redis or other server already running on the machine.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8001

# Auth. JWT_SECRET signs access tokens: at least 32 bytes, random, never committed.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-local-development-only
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_S=10
# Browsers accept Secure cookies on http://localhost; set false only for another plain-HTTP host.
COOKIE_SECURE=true

# Rate limits as "<requests>/<seconds>".
RATE_LIMIT_LOGIN_USERNAME=10/900
RATE_LIMIT_LOGIN_IP=30/900
RATE_LIMIT_SIGNUP_IP=5/3600
RATE_LIMIT_UPLOAD_USER=20/60
RATE_LIMIT_UPLOAD_USER_DAILY=200/86400
RATE_LIMIT_CHANNEL_CREATE_USER=10/3600
RATE_LIMIT_DM_CREATE_USER=10/60
RATE_LIMIT_WS_EVENTS=30/1

# Voice messages. Media lives in a Docker volume (/data/media) shared by api and worker.
MEDIA_DIR=var/media
MAX_UPLOAD_BYTES=10485760
MIN_DURATION_MS=500
MAX_DURATION_MS=60000

# Transcription: local (faster-whisper in the transcriber container), openai, or off.
TRANSCRIBE_PROVIDER=local
# faster-whisper model: tiny, base (built into the image), small, medium, large-v3 ...
WHISPER_MODEL=base
# Outside Docker; the transcriber container uses /models (a volume).
WHISPER_MODEL_DIR=var/whisper-models
# A language code such as en or ar; empty detects the language of each message.
TRANSCRIBE_LANGUAGE=
# Only for TRANSCRIBE_PROVIDER=openai. The audio is then sent to OpenAI.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Celery broker (Redis database 1). Inside Docker: redis://redis:6379/1
CELERY_BROKER_URL=redis://localhost:6380/1

# Flower (Celery dashboard) on http://localhost:5555, as user:password.
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:pushtalk-dev
