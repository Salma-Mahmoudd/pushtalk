@startuml er-diagrams-chat
title Chat — ER diagram

hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Helvetica

entity "users\n(owned by auth)" as users #EEEEEE {
  * id : uuid <<PK>>
  --
  * username : varchar(32)
}

entity "channels" as channels {
  * id : uuid <<PK>>
  --
  * kind : channel_kind
    -- group | direct
    name : varchar(50)
    -- group only; UNIQUE on lower(name)
    dm_key : varchar(73) <<UNIQUE>>
    -- direct only: "{min(user_a,user_b)}:{max(...)}"
    -- guarantees one DM channel per user pair
  * created_by : uuid <<FK users.id>>
  * last_seq : int default 0
    -- per-channel sequence counter
  * created_at : timestamptz
  --
  CHECK (kind='group' AND name IS NOT NULL AND dm_key IS NULL
      OR kind='direct' AND name IS NULL AND dm_key IS NOT NULL)
}

entity "channel_members" as members {
  * channel_id : uuid <<PK, FK channels.id>>
  * user_id : uuid <<PK, FK users.id>>
  --
  * joined_at : timestamptz
}

entity "messages" as messages {
  * id : uuid <<PK>>
  --
  * channel_id : uuid <<FK channels.id>>
  * sender_id : uuid <<FK users.id>>
  * client_msg_id : uuid
    -- idempotency key from the browser
  * status : message_status
    -- processing | ready | failed
    seq : int
    -- NULL until ready; assigned by the worker
    duration_ms : int
    -- from ffprobe, never from the client
    waveform : smallint[]
    -- 64 peaks, 0..100
  * original_key : varchar(200)
    -- originals/{random}.{ext} in the media volume (deleted once ready)
    audio_key : varchar(200)
    -- processed/{id}.ogg
    failure_reason : varchar(100)
    transcript_status : transcript_status
    -- pending | done | failed; NULL when transcription is off
    transcript : text
    transcript_lang : varchar(16)
  * created_at : timestamptz
    ready_at : timestamptz
  --
  UNIQUE (channel_id, seq)
  UNIQUE (sender_id, client_msg_id)
  INDEX (channel_id, created_at)
}

entity "message_receipts" as receipts {
  * message_id : uuid <<PK, FK messages.id>>
  * user_id : uuid <<PK, FK users.id>>
  --
  * delivered_at : timestamptz
    played_at : timestamptz
}

users ||--o{ channels : creates
channels ||--o{ members : has
users ||--o{ members : joins
channels ||--o{ messages : contains
users ||--o{ messages : sends
messages ||--o{ receipts : "tracked by"
users ||--o{ receipts : acknowledges

note right of receipts
  Row created on first "delivered" ack;
  played_at set on "played" ack.
  Sender sees BOTH views:
  • aggregated on the bubble: delivered n/m, played n/m
    (m = members − sender)
  • per-recipient list on click:
    GET /api/messages/{id}/receipts
end note

note bottom of channels
  Ephemeral state lives in Redis, not Postgres:
  presence:{channel_id}  ZSET  member "{user_id}:{conn_id}", score = last heartbeat
    online = users with a member scored > now − 60 s (multi-tab + crash safe:
    a dead api pod stops heart-beating, its entries expire on their own)
    presence:00000000-0000-0000-0000-000000000000 = app-wide (/ws/me), for DM online dots
  player:{channel_id}:{user_id}  the connection that plays the channel for that user
  ratelimit:{scope}:{key}  sliding-window ZSETs (login, signup, upload, channel and DM creation)
end note
@enduml
