@startuml class-diagrams-chat-channels
title Chat — Backend: channels, presence and direct messages (pushtalk.channels, pushtalk.directs)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
hide empty members

package "pushtalk.channels" {
  class "router" as channels_router <<APIRouter /api/channels>> {
    + GET /  (groups only)
    + POST /  (rate limited)
    + GET /{id}
    + POST /{id}/join
    + GET /{id}/members
  }
  class ChannelService {
    + create(user, name) : ChannelOut
    + list_all(user) : list[ChannelOut]
    + get(user, channel_id) : ChannelOut  (peer for direct)
    + join(user, channel_id) : None  (403 for direct)
    + require_member(user_id, channel_id) : Channel
    + members(user, channel_id) : list[MemberOut]
  }
  class PresenceService {
    + ttl_s : int = 60
    + connect(channel_id, user_id, conn_id) : bool
    + heartbeat(channel_id, user_id, conn_id) : None
    + disconnect(channel_id, user_id, conn_id) : bool
    + online(channel_id) : set[UUID]
    + sweep() : list[(channel_id, user_id)]
  }
  class ChannelRepository {
    + get(id) : Channel | None
    + add(channel) : None
    + add_member(channel_id, user_id) : bool
    + is_member(channel_id, user_id) : bool
    + list_groups(user_id) : list[(Channel, is_member, count)]
    + members(channel_id) : list[User]
    + next_seq(channel_id) : int  <<UPDATE … RETURNING>>
  }
  class Channel <<SQLAlchemy>> {
    + id : UUID
    + kind : ChannelKind
    + name : str | None
    + dm_key : str | None  <<unique>>
    + created_by : UUID
    + last_seq : int
  }
  class ChannelMember <<SQLAlchemy>> {
    + channel_id : UUID
    + user_id : UUID
    + joined_at : datetime
  }
  enum ChannelKind {
    group
    direct
  }
}

package "pushtalk.directs" {
  class "router" as directs_router <<APIRouter>> {
    + GET /api/users?query=
    + GET /api/dms
    + POST /api/dms {user_id}  → 201 new / 200 existing
  }
  class DirectService {
    + open(user, peer_id) : (DirectOut, created: bool)
    + list_for(user) : list[DirectOut]
    + search_users(user, prefix) : list[UserOut]
  }
  class DirectRepository {
    + get_or_create(user_id, peer_id) : (Channel, bool)  <<ON CONFLICT dm_key>>
    + list_for(user_id) : list[(Channel, User)]
    + search_users(prefix, exclude) : list[User]
  }
}

package "other modules" #EEEEEE {
  class "RateLimiter\n(pushtalk.infra)" as RateLimiter
  class "EventBus\n(pushtalk.realtime)" as EventBus
}

channels_router ..> ChannelService
channels_router ..> RateLimiter : channel_create
ChannelService --> ChannelRepository
ChannelService --> PresenceService : online
ChannelService --> EventBus : member.joined
ChannelRepository ..> Channel
ChannelRepository ..> ChannelMember
Channel --> ChannelKind
directs_router ..> DirectService
directs_router ..> RateLimiter : dm_create
DirectService --> DirectRepository
DirectService --> PresenceService : online (APP_PRESENCE)
DirectService --> EventBus : dm.created
DirectRepository ..> Channel
DirectRepository ..> ChannelMember
@enduml

@startuml class-diagrams-chat-messages
title Chat — Backend: voice message pipeline (pushtalk.messages, worker, transcription, infra)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
hide empty members

package "pushtalk.messages" {
  class "router" as messages_router <<APIRouter>> {
    + POST /api/channels/{id}/messages  (multipart) → 202
    + GET /api/channels/{id}/messages?after_seq|before_seq
    + GET /api/messages/{id}/audio  (Range)
    + GET /api/messages/{id}/receipts  (sender only)
  }
  class MessageService {
    + create_voice_message(user, channel_id, upload, client_msg_id) : MessageOut
    + history(user, channel_id, after_seq?, before_seq?, limit) : MessagePage
    + audio_path(user, message_id) : Path  (404 for non-members)
  }
  class ReceiptService {
    + record(user_id, channel_id, message_id, status) : None
    + summaries(messages) : dict[id, ReceiptSummary]
    + details(user_id, message_id) : list[RecipientReceipt]
  }
  class MessageRepository {
    + add(message) : None
    + get(id) / get_by_client_id(sender_id, client_msg_id)
    + lock(id) : Message | None  <<FOR UPDATE>>
    + list_ready(channel_id, after_seq?, before_seq?, limit) : (list, has_more)
    + list_pending(channel_id, sender_id) : list[MessageOut]
  }
  class processing <<module>> {
    + process_message(id, ctx) : None
    + fail_message(id, reason, ctx) : None
  }
  class ProcessingContext <<dataclass>> {
    + sessionmaker
    + storage : FileStorage
    + bus : EventBus
    + enqueue_transcription : Callable | None
  }
  class Message <<SQLAlchemy>> {
    + id : UUID
    + channel_id : UUID
    + sender_id : UUID
    + client_msg_id : UUID
    + status : MessageStatus
    + seq : int | None
    + duration_ms : int | None
    + waveform : list[int] | None
    + original_key : str
    + audio_key : str | None
    + failure_reason : str | None
    + transcript_status : TranscriptStatus | None
    + transcript : str | None
    + transcript_lang : str | None
  }
  class MessageReceipt <<SQLAlchemy>> {
    + message_id : UUID
    + user_id : UUID
    + delivered_at : datetime
    + played_at : datetime | None
  }
  enum MessageStatus {
    processing
    ready
    failed
  }
  enum TranscriptStatus {
    pending
    done
    failed
  }
}

package "pushtalk.worker" {
  class celery_app <<Celery>> {
    broker = Redis (db 1)
    acks_late, reject_on_worker_lost
    prefetch 1; queues audio, transcribe
  }
  class process_message_task <<task, queue audio>> {
    retries infrastructure errors 3×, then fail_message
    async code via asyncio.run()
  }
  class transcribe_message_task <<task, queue transcribe>> {
    retries 2×, time limit 120 s, then fail_transcription
  }
}

package "pushtalk.transcription" {
  class job <<module>> {
    + transcribe_message(id, ctx, transcriber) : None
    + fail_transcription(id, ctx) : None
  }
  interface Transcriber {
    + transcribe(path) : Transcript(text, language)
  }
  class LocalWhisperTranscriber {
    faster-whisper, CPU int8
    WHISPER_MODEL (default base)
  }
  class OpenAITranscriber {
    TRANSCRIBE_PROVIDER=openai, OPENAI_API_KEY
  }
  class FakeTranscriber <<test>>
  class get_transcriber <<factory>> {
    None when TRANSCRIBE_PROVIDER=off
  }
}

package "pushtalk.infra" {
  class FileStorage {
    media volume; keys must stay inside it
    + path(key) : Path
    + temp_path(suffix) : Path
    + move_in(source, key) : None
    + delete(key) : None
  }
  class audio <<module>> {
    + sniff(header) : Container | None
    + duration_ms(path) : int  (ffprobe, packet scan fallback)
    + transcode_to_opus(src, dst) : None  (ffmpeg)
    + waveform_peaks(path, buckets=64) : list[int]
  }
}

package "other modules" #EEEEEE {
  class "ChannelService\n(pushtalk.channels)" as ChannelService
  class "ChannelRepository\n(pushtalk.channels)" as ChannelRepository
  class "EventBus\n(pushtalk.realtime)" as EventBus
  class "RateLimiter\n(pushtalk.infra)" as RateLimiter
}

messages_router ..> MessageService
messages_router ..> ReceiptService
messages_router ..> RateLimiter : upload, upload_daily
MessageService --> ChannelService : require_member
MessageService ..> audio : sniff, duration_ms
MessageService --> MessageRepository
MessageService --> ReceiptService : summaries
MessageService --> FileStorage
MessageService ..> process_message_task : enqueue
ReceiptService --> EventBus : receipt.updated
MessageRepository ..> Message
ReceiptService ..> MessageReceipt
Message --> MessageStatus
Message --> TranscriptStatus
celery_app o-- process_message_task
celery_app o-- transcribe_message_task
process_message_task ..> processing
transcribe_message_task ..> job
transcribe_message_task ..> get_transcriber
processing ..> ProcessingContext
processing --> MessageRepository : lock
processing --> ChannelRepository : next_seq
processing ..> audio
processing --> EventBus : message.ready / failed
processing ..> transcribe_message_task : enqueue_transcription
job --> EventBus : message.transcribed
job ..> Transcriber
ProcessingContext --> FileStorage
get_transcriber ..> Transcriber
Transcriber <|.. LocalWhisperTranscriber
Transcriber <|.. OpenAITranscriber
Transcriber <|.. FakeTranscriber
@enduml

@startuml class-diagrams-chat-realtime
title Chat — Backend: realtime WebSockets (pushtalk.realtime)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
hide empty members

package "pushtalk.realtime" {
  class "router" as ws_router <<WebSocket /ws/channels/{id}  +  /ws/me>> {
    cookie auth (4401) + Origin check on handshake
    channel: membership (4403), hello, presence,
    catch-up since_seq, ping/pong, receipts, playback.claim
    me: dm.created, app-wide presence
    30 client events / s per connection
  }
  class ConnectionManager {
    one Redis subscription per process
    + register(conn, topics) : None
    + unregister(conn) : None
    + close() : None
  }
  class Connection {
    + id : UUID
    + websocket : WebSocket
    + user_id : UUID
    + session_id : UUID
    + send(event) : None
  }
  class PlayerRegistry {
    which connection plays a channel for a user (Redis)
    + claim(channel_id, user_id, conn_id) : None
    + claim_if_free(channel_id, user_id, conn_id) : None
    + release(channel_id, user_id, conn_id) : None
  }
  class EventBus {
    Redis pub/sub topics ch:{id}, user:{id}
    + publish(topic, event) : None
  }
  class sweeper <<background task>> {
    + sweep_presence_forever(redis, presence)
  }
}

package "other modules" #EEEEEE {
  class "PresenceService\n(pushtalk.channels)" as PresenceService
  class "ReceiptService\n(pushtalk.messages)" as ReceiptService
  class "MessageRepository\n(pushtalk.messages)" as MessageRepository
  class "authenticate_websocket\n(pushtalk.auth.deps)" as authws
  class "LocalRateLimiter\n(pushtalk.infra)" as LocalRateLimiter
}

ws_router ..> authws
ws_router ..> ConnectionManager
ws_router ..> PresenceService : connect / heartbeat
ws_router ..> ReceiptService : delivered / played
ws_router ..> MessageRepository : catch-up
ws_router ..> PlayerRegistry : playback.claim
ws_router ..> LocalRateLimiter
PlayerRegistry --> EventBus : playback.claimed
ConnectionManager "1" o-- "*" Connection
sweeper ..> PresenceService
sweeper ..> EventBus : presence.update
@enduml

@startuml class-diagrams-chat-frontend
title Chat — Frontend modules (apps/web/src)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
hide empty members

package "shared/lib/ws" {
  class WsClient {
    + connect() / close() : void
    + send(event) : boolean
    url() called on every (re)connect
    reconnect with backoff; at once when online;
    drops the socket when offline;
    4401 → refresh once; 4403 → stop
  }
  class backoff <<pure fn>> {
    + nextDelay(attempt) : number  (0.5 s × 2ⁿ, cap 30 s, ±20 %)
  }
}

package "features/voice" {
  class Recorder {
    + start() : Promise<void>
    + stop() : Promise<{blob, durationMs}>
    + cancel() : void
  }
  class PlaybackQueue <<pure, no DOM>> {
    items sorted by seq; one playing at a time
    + enqueue(item) / playNow(item) / stopCurrent()
    + unlock() / setActive(active)
    + recordingStarted() / recordingStopped()
    + setRate(rate)
    + snapshot() : {state, currentId, waiting, recording}
  }
  interface AudioPlayer {
    + play(src) / pause() / resume() / stop()
    + setRate(rate) / unlock() / preload?(src)
    + onEnded(cb) / onError(cb)
  }
  class HtmlAudioPlayer {
    audio element + preloader;
    cookie-authenticated src; renews the session once on error
  }
  class FakeAudioPlayer <<test>>
  class usePlayback <<hook>> {
    one queue per room; unlocks on first tap or key
  }
  class playbackSettings <<zustand + persist>> {
    + rate : 1 | 1.5 | 2
  }
  class PttButton <<component>>
  class SpeedControl <<component>>
  class "AudioUnlockBanner /\nPlayHereBanner /\nHeldWhileTalkingBadge" as banners <<components>>
}

package "features/channels" {
  class useChannelSocket <<hook>> {
    hello, catchup, gap fill, message.*,
    receipt.updated, playback.claimed, presence
  }
  class useChannelHistory <<hook>> {
    first page + "Load older"
  }
  class messageStore <<zustand>> {
    keyed by client_msg_id; status and transcript only move forward
    + upsert / putLocal / markFailed / setReceipts / setTranscript
  }
  class ChannelRoom <<component>>
  class MessageList <<component>> {
    bubble: waveform, duration, status n/m, TranscriptView
  }
  class ReceiptDetails <<component>>
  class sendRecording <<fn>> {
    optimistic bubble; idempotent retry by client_msg_id
  }
}

package "features/directs" {
  class directsApi <<module>> {
    + list() / open(userId) / searchUsers(q)
  }
  class useUserSocket <<hook, WsClient on /ws/me>> {
    dm.created → refresh the list
  }
  class DirectList <<component>>
  class NewDirectDialog <<component>>
}

AudioPlayer <|.. HtmlAudioPlayer
AudioPlayer <|.. FakeAudioPlayer
PlaybackQueue --> AudioPlayer
usePlayback --> PlaybackQueue
usePlayback ..> playbackSettings : rate
SpeedControl ..> playbackSettings
ChannelRoom --> usePlayback
ChannelRoom --> useChannelSocket
ChannelRoom --> useChannelHistory
ChannelRoom *-- MessageList
ChannelRoom *-- PttButton
ChannelRoom *-- SpeedControl
ChannelRoom *-- banners
ChannelRoom ..> sendRecording
MessageList ..> ReceiptDetails : own messages
PttButton --> Recorder
useChannelSocket --> WsClient
useChannelSocket ..> messageStore
useChannelHistory ..> messageStore
sendRecording ..> messageStore
WsClient ..> backoff
useUserSocket --> WsClient
DirectList ..> directsApi
NewDirectDialog ..> directsApi
@enduml
