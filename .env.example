# Copy to .env to override. Every key has a safe development default,
# so the app also starts without a .env file.

# API logging: DEBUG | INFO | WARNING | ERROR, and json | console output.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Origins allowed to send state-changing requests and open WebSockets (CSRF protection).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
